# Supabase — Project Settings → API / API Keys
# URL is always required:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Guest form inserts (public). Use EITHER legacy anon JWT (eyJ…) OR new publishable key (sb_publishable_…):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_sb_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Staff reads (server only — never NEXT_PUBLIC_). Use EITHER legacy service_role JWT (eyJ…, role=service_role)
# OR new secret key (sb_secret_…). Do NOT paste the anon/publishable key here.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
# SUPABASE_SECRET_KEY=sb_secret_...

# Owner browse page (/staff) — full feedback + analytics + export + create user + visibility
# Bootstrap password until at least one active owner exists in staff_users.
# After DB users exist, login requires username + password.
STAFF_PASSWORD=choose-a-strong-owner-password
# Management portal (/management) — visibility controlled by owner; can see pending (not approve)
MANAGEMENT_PASSWORD=choose-a-strong-management-password
# Staff desk (/reception) — category averages by default (no review rows)
RECEPTION_PASSWORD=choose-a-strong-reception-password
# IT manager portal (/it) — must approve before feedback becomes a live system review
IT_MANAGER_PASSWORD=choose-a-strong-it-manager-password
# Signs the shared staff session cookie (role: owner | management | reception | it_manager); ≥16 chars
STAFF_SESSION_SECRET=generate-a-long-random-string-min-16-chars

# Hotel website API key for GET /api/website/reviews
# Pass as: Authorization: Bearer <key>  OR  X-Api-Key: <key>
# Owner can also create a staff_users row with role website_api (documentation / future use).
WEBSITE_API_KEY=generate-a-long-random-website-api-key

# Server-side geofence (option B) — IP / CIDR allowlist. No browser geolocation.
# Comma-separated IPv4 addresses or CIDRs. Use * to allow all (testing only).
# Empty allowlist: production fails closed; local/dev allows 127.0.0.1 only.
# Example lodge WAN / Wi‑Fi egress: 41.90.12.0/24,105.53.10.22
ABAI_GEOFENCE_ALLOWLIST=127.0.0.1,::1
# Legacy lat/lng/radius vars are ignored (batch 5). Safe to remove from Vercel:
# ABAI_GEOFENCE_LAT=
# ABAI_GEOFENCE_LNG=
# ABAI_GEOFENCE_RADIUS_M=
