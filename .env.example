# Supabase — Project Settings → API / API Keys
# URL is always required:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Guest form inserts (public). Use EITHER legacy anon JWT (eyJ…) OR new publishable key (sb_publishable_…):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_sb_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Staff reads (server only — never NEXT_PUBLIC_). Use EITHER legacy service_role JWT (eyJ…, role=service_role)
# OR new secret key (sb_secret_…). Do NOT paste the anon/publishable key here.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
# SUPABASE_SECRET_KEY=sb_secret_...

# Owner browse page (/staff) — full feedback + analytics + export + create user + visibility
# Bootstrap password until at least one active owner exists in staff_users.
# After DB users exist, login requires username + password.
STAFF_PASSWORD=choose-a-strong-owner-password
# Management portal (/management) — visibility controlled by owner
MANAGEMENT_PASSWORD=choose-a-strong-management-password
# Staff desk (/reception) — category averages by default (no review rows)
RECEPTION_PASSWORD=choose-a-strong-reception-password
# Signs the shared staff session cookie (role: owner | management | reception); ≥16 chars
STAFF_SESSION_SECRET=generate-a-long-random-string-min-16-chars

# Guest form geofence — submit only within this circle (fail closed if location denied).
# Defaults: Abai Lodges & Spa, Kagio / Kirinyaga County, Kenya (public listing ≈ -0.62515, 37.253069).
# Override if you have a more precise lodge pin.
ABAI_GEOFENCE_LAT=-0.62515
ABAI_GEOFENCE_LNG=37.253069
# Radius in metres (lodge grounds + parking buffer)
ABAI_GEOFENCE_RADIUS_M=500
