# Supabase — Project Settings → API / API Keys
# URL is always required:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Guest form inserts (public). Use EITHER legacy anon JWT (eyJ…) OR new publishable key (sb_publishable_…):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_sb_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Staff reads (server only — never NEXT_PUBLIC_). Use EITHER legacy service_role JWT (eyJ…, role=service_role)
# OR new secret key (sb_secret_…). Do NOT paste the anon/publishable key here.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
# SUPABASE_SECRET_KEY=sb_secret_...

# Staff browse page (/staff)
STAFF_PASSWORD=choose-a-strong-shared-password
STAFF_SESSION_SECRET=generate-a-long-random-string-min-16-chars
